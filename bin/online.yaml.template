# ETCD 配置
etcd:
  endpoints: # ETCD 地址列表，例如: 192.168.71.123:2379
    - 192.168.71.123:2379
    - 192.168.71.123:22379
    - 192.168.71.123:32379
  ttlDuration: 33000000s # ttl [default]: xetcdconstants.TtlSecondDefault, e.g.:系统每10秒续约一次,该参数至少为11秒

# 基础配置
base:
  projectName: project  # 项目名称
  groupID: 1 # 分组ID
  name: online # 服务名称
  serverID: 1 # 服务ID
  version: v.0.0.1.2025.03.21.12.21          # 项目版本
  # packetLengthMax: 100000        # 数据包最大长度
  # sendChannelCapacity: 100000      # 发送通道容量
  runMode: 1                        # 运行模式 [0:release, 1:debug]
  availableLoad: 100000            # 可用负载

# 日志
log:
  level: 7        # 日志级别

# gRPC 配置
grpc:
  packageName: online
  serviceName: OnlineService
  listenAddr: 0.0.0.0:20201
  externalAddr: 192.168.71.123:20201
  maxReceiveMessageBytes: 67108864
  maxSendMessageBytes: 67108864

# 毫秒定时器用于账号移动队列, 20ms扫描并使用最近到期小顶堆.
timer:
  scanMillisecondDuration: 20ms # 移动任务扫描颗粒度
  millisecondType: 1 # 1表示小顶堆, 优先弹出最近到期任务

# online 自定义配置
custom:
  gameConfigDir: ../config # 共享游戏配置目录, 本地 bin 启动时相对 bin/online.yaml 解析到项目根目录 config

